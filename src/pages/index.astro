---
import { Image } from "astro:assets";
import profilePicture from "../assets/profile-picture.png";
import sectionGradient from "../assets/section_gradient.svg";
import Layout from "../layouts/Layout.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<main class="">
		<div class="">
			<div
				class="absolute -top-32 left-0 -z-10 h-[700px] w-full scale-125 -rotate-6 bg-[radial-gradient(ellipse_101.73%_140.07%_at_30.39%_0.00%,_#1A1A1A_54%,_rgba(26,_26,_26,_0.50)_100%)] opacity-50"
			>
			</div>
			<div
				class="absolute top-0 left-0 -z-10 h-[450px] w-full bg-(image:--gradient)"
			>
			</div>
			<section class="relative container mx-auto my-8 max-w-5xl px-6 md:px-12">
				<div class="grid items-center gap-12 md:grid-cols-2">
					<div class="z-10" data-reveal style="--rd:0ms">
						<div class="relative ps-12">
							<div
								class="absolute top-0 left-0 h-full w-px bg-gradient-to-b from-white/50 to-transparent"
							>
							</div>
							<div class="py-8 font-mono text-4xl text-white">Hey, ich bin</div>
							<div
								class="h-px w-full bg-gradient-to-r from-white/40 to-transparent"
							>
							</div>
							<div class="text-primary py-8 font-mono text-6xl">Tim</div>
							<div
								class="h-px w-full bg-gradient-to-r from-white/40 to-transparent"
							>
							</div>
							<nav
								aria-label="Social Links"
								class="flex flex-wrap items-center gap-3 py-8"
							>
								<a
									href="https://www.youtube.com/"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="YouTube"
									class="hover:text-primary hover:outline-primary/60 flex size-11 items-center justify-center text-white/70 outline-1 outline-offset-[-1px] outline-white/20 backdrop-blur-sm transition-colors"
								>
									<svg
										class="size-5"
										viewBox="0 0 24 24"
										fill="currentColor"
										aria-hidden="true"
									>
										<path
											d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
										></path>
									</svg>
								</a>
								<a
									href="https://www.instagram.com/"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Instagram"
									class="hover:text-primary hover:outline-primary/60 flex size-11 items-center justify-center text-white/70 outline-1 outline-offset-[-1px] outline-white/20 backdrop-blur-sm transition-colors"
								>
									<svg
										class="size-5"
										viewBox="0 0 24 24"
										fill="currentColor"
										aria-hidden="true"
									>
										<path
											d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
										></path>
									</svg>
								</a>
								<a
									href="https://github.com/"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="GitHub"
									class="hover:text-primary hover:outline-primary/60 flex size-11 items-center justify-center text-white/70 outline-1 outline-offset-[-1px] outline-white/20 backdrop-blur-sm transition-colors"
								>
									<svg
										class="size-5"
										viewBox="0 0 24 24"
										fill="currentColor"
										aria-hidden="true"
									>
										<path
											d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
										></path>
									</svg>
								</a>
								<a
									href="https://www.linkedin.com/"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="LinkedIn"
									class="hover:text-primary hover:outline-primary/60 flex size-11 items-center justify-center text-white/70 outline-1 outline-offset-[-1px] outline-white/20 backdrop-blur-sm transition-colors"
								>
									<svg
										class="size-5"
										viewBox="0 0 24 24"
										fill="currentColor"
										aria-hidden="true"
									>
										<path
											d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
										></path>
									</svg>
								</a>
								<a
									href="mailto:kontakt@timschulz.net"
									aria-label="E-Mail"
									class="hover:text-primary hover:outline-primary/60 flex size-11 items-center justify-center text-white/70 outline-1 outline-offset-[-1px] outline-white/20 backdrop-blur-sm transition-colors"
								>
									<svg
										class="size-5"
										viewBox="0 0 24 24"
										fill="currentColor"
										aria-hidden="true"
									>
										<path
											d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
										></path>
									</svg>
								</a>
							</nav>
						</div>
					</div>

					<div
						class="z-10 flex scale-90 justify-center md:justify-end"
						data-reveal
						style="--rd:140ms"
					>
						<div class="relative h-56 w-56 md:h-80 md:w-80">
							<div
								class="bg-background absolute inset-0 rounded-full border border-white/20 shadow-[0px_0px_36px_8px_rgba(0,0,0,0.25)]"
							>
							</div>
							<div
								class="absolute inset-0 rounded-full bg-[radial-gradient(ellipse_100.04%_130.58%_at_31.37%_0.00%,_#D94A17_0%,_rgba(231.54,_85.68,_33.66,_0.55)_62%,_rgba(193.80,_133.96,_112.20,_0.10)_100%)]"
							>
							</div>
							<Image
								src={profilePicture}
								alt="Tim Schulz Portrait"
								class="absolute bottom-0 w-full rounded-full"
							/>
						</div>
					</div>
				</div>
			</section>

			<section class="container mx-auto max-w-5xl px-6 md:px-12">
				<div
					class="relative w-full bg-[radial-gradient(ellipse_113.17%_241.11%_at_41.02%_112.41%,_rgba(26,_26,_26,_0.20)_0%,_rgba(126,_126,_126,_0.14)_100%)] p-8 shadow-[0px_0px_70px_10px_rgba(198,113,83,0.25)] outline-1 outline-offset-[-1px] outline-white/20 backdrop-blur-sm"
					data-reveal
					style="--rd:240ms"
				>
					<div class="flex flex-col gap-6">
						<div class="font-mono text-4xl leading-9 font-normal text-white">
							Über mich
						</div>
						<div class="grid gap-6 md:grid-cols-2">
							<p class="font-sans text-base leading-normal text-white">
								Ich habe Informatik studiert und entwickle seit Jahren Websites
								und Webanwendungen. Mein Fokus liegt auf einer durchdachten User
								Experience – Anwendungen sollen nicht nur funktionieren, sondern
								sich gut bedienen lassen.
							</p>
							<p class="font-sans text-base leading-normal text-white">
								Als IT-Berater und Anwendungsentwickler setze ich Projekte in
								unterschiedlichsten Bereichen um: Von der Restrukturierung
								gewachsener Systeme bis hin zu individuellen Webanwendungen.
							</p>
						</div>
					</div>
				</div>
			</section>
		</div>
	</main>

	<style>
		@keyframes reveal-in {
			from {
				opacity: 0;
				transform: translateY(16px);
			}
			to {
				opacity: 1;
				transform: none;
			}
		}
		[data-reveal] {
			animation: reveal-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
			animation-delay: var(--rd, 0ms);
		}
		@media (prefers-reduced-motion: reduce) {
			[data-reveal] {
				animation: none;
			}
		}
	</style>
</Layout>
