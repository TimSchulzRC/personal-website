---
import { getImage } from "astro:assets";
import Layout from "./Layout.astro";
import MediumLink from "../components/MediumLink.astro";
import ReadingBackdrop from "../components/ReadingBackdrop.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, getRoute, getAlternates } from "../i18n/utils";
import type { LocalizedPost } from "../lib/blog";

interface Props {
  lang: Lang;
  post: LocalizedPost;
}

const { lang, post } = Astro.props;
const t = useTranslations(lang);

const site = Astro.site ?? new URL("https://timschulz.net");
const blog = getAlternates("blog");
const alternates = {
  de: `${blog.de}${post.id}/`,
  en: `${blog.en}${post.id}/`,
};
const originalUrl = new URL(alternates.en, site).href;
// With a translation, each language version is its own page for search
// engines. Without one, the German page repeats the English article and
// points to it as canonical; passing it also suppresses hreflang links.
const canonical = post.hasTranslation
  ? new URL(alternates[lang], site).href
  : originalUrl;
const isTranslation = post.contentLang !== "en";

const dateFormat = new Intl.DateTimeFormat(lang, { dateStyle: "long" });

// Download Medium images at build time and serve them from this site, so
// visitors' browsers never contact Medium.
let content = post.content;
const imageSrcs = new Set(
  [...content.matchAll(/<img[^>]*src="([^"]+)"/g)].map((m) => m[1]),
);
for (const src of imageSrcs) {
  const image = await getImage({ src, inferSize: true, format: "webp" });
  content = content.replaceAll(
    `src="${src}"`,
    `src="${image.src}" width="${image.attributes.width}" height="${image.attributes.height}" loading="lazy" decoding="async"`,
  );
}

// Social networks don't reliably support WebP previews, so use JPEG.
const cover =
  post.image &&
  (await getImage({
    src: post.image,
    inferSize: true,
    width: 1200,
    format: "jpeg",
  }));
const ogImage = cover
  ? {
      src: new URL(cover.src, site).href,
      width: Number(cover.attributes.width),
      height: Number(cover.attributes.height),
      alt: post.title,
    }
  : undefined;

const postLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  url: canonical,
  mainEntityOfPage: canonical,
  datePublished: post.pubDate.toISOString(),
  dateModified: post.updated.toISOString(),
  image: ogImage ? [ogImage.src] : undefined,
  keywords: post.categories.join(", ") || undefined,
  inLanguage: post.contentLang,
  ...(isTranslation
    ? { translationOfWork: { "@type": "BlogPosting", url: originalUrl } }
    : { sameAs: post.url }),
  author: {
    "@type": "Person",
    name: "Tim Schulz",
    url: site.href,
  },
};
---

<Layout
	lang={lang}
	routeKey="blog"
	alternates={alternates}
	canonicalUrl={post.hasTranslation ? undefined : canonical}
	title={`${post.title} – Tim Schulz`}
	description={post.excerpt}
	ogType="article"
	ogImage={ogImage}
>
	<Fragment slot="head">
		<meta
			property="article:published_time"
			content={post.pubDate.toISOString()}
		/>
		<meta
			property="article:modified_time"
			content={post.updated.toISOString()}
		/>
		<meta property="article:author" content={site.href} />
		{post.categories.map((tag) => <meta property="article:tag" content={tag} />)}
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(postLd)}
		/>
	</Fragment>

	<main
		id="main"
		class="relative z-10 container mx-auto max-w-3xl px-6 py-16 md:px-12"
	>
		<ReadingBackdrop />

		<a
			href={getRoute("blog", lang)}
			class="hover:text-primary font-mono text-sm text-white/50 transition-colors"
			>← {t("blog.back")}</a
		>

		<article
			class="mt-6"
			lang={post.contentLang !== lang ? post.contentLang : undefined}
		>
			<header>
				<time
					datetime={post.pubDate.toISOString()}
					class="font-mono text-xs text-white/50"
				>
					{dateFormat.format(post.pubDate)}
				</time>
				<h1 class="mt-2 font-mono text-3xl text-white md:text-4xl">
					{post.title}
				</h1>
				<MediumLink
					href={post.url}
					label={t("blog.readOnMedium")}
					class="mt-4"
				/>
				{
					lang === "de" && (
						<p
							lang={lang}
							class="border-primary/60 mt-8 border-l-2 bg-white/5 px-4 py-3 font-sans text-sm text-white/70"
						>
							{isTranslation ? (
								<>
									{t("blog.machineTranslated")}{" "}
									<a
										href={alternates.en}
										hreflang="en"
										data-lang-switch
										data-lang="en"
										class="text-primary underline underline-offset-2 hover:opacity-85"
									>
										{t("blog.readOriginal")} →
									</a>
								</>
							) : (
								t("blog.onlyEnglish")
							)}
						</p>
					)
				}
			</header>

			<div
				class="prose prose-invert prose-a:text-primary prose-headings:font-mono prose-figcaption:text-white/50 mt-10 max-w-none font-sans"
				set:html={content}
			/>

			<footer
				class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-white/20 pt-6 font-mono text-sm"
			>
				<span class="text-white/50">{t("blog.onMedium")}</span>
				<a
					href={post.url}
					target="_blank"
					rel="noopener noreferrer"
					class="text-primary hover:opacity-85">{t("blog.readOnMedium")} →</a
				>
			</footer>
		</article>
	</main>
</Layout>
