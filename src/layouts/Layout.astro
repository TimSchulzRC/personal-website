---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="preload"
			href="/fonts/FiraMono-Regular.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/FiraMono-Medium.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/FiraMono-Bold.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		/>

		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class="bg-background mx-6 overflow-x-hidden md:mx-12">
		<header class="z-10 container mx-auto max-w-5xl">
			<nav class="border-b-1 border-white/50 py-6">
				<div class="font-mono font-light text-white">Tim Schulz</div>
			</nav>
		</header>
		<slot />
	</body>
</html>
