---
import bgPattern from "../assets/bg-pattern.svg";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="preload"
			href="/fonts/FiraMono-Regular.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/FiraMono-Medium.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/FiraMono-Bold.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		/>

		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class="bg-background relative overflow-x-hidden">
		<div
			class="pointer-events-none absolute inset-0 -z-50 bg-top bg-repeat opacity-25"
			style={`background-image: url(${bgPattern.src})`}
		>
		</div>
		<header class="z-10 container mx-auto max-w-5xl px-6 md:px-12">
			<nav class="flex items-center gap-6 py-6">
				<span class="font-mono text-sm tracking-[0.35em] text-white/70"
					>TIM SCHULZ</span
				>
				<div
					class="h-px flex-1 bg-gradient-to-r from-white/40 to-transparent"
				>
				</div>
			</nav>
		</header>
		<slot />
	</body>
</html>
